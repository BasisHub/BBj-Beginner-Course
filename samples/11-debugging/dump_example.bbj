rem === DUMP: Variable Snapshot to File ===
rem Demonstrates: DUMP verb to write all variables to a file, filtered DUMP for current scope
rem Expected output:
rem   Variables dumped to /tmp/debug_dump.txt
rem   --- Filtered DUMP (current scope) ---
rem   (variables printed to console)
rem
rem After running, inspect /tmp/debug_dump.txt to see all variables.

rem Create variables of different types
name$ = "Alice"
role$ = "Developer"
count = 42
total = 99.95
active = 1

rem Create an object reference (BBjVector)
items! = BBjAPI().makeVector()
items!.addItem("first")
items!.addItem("second")
items!.addItem("third")

rem Dump all variables to a file
open(7, mode="O_CREATE,O_TRUNC")"/tmp/debug_dump.txt"
dump(7)
close(7)
print "Variables dumped to /tmp/debug_dump.txt"

rem Filtered DUMP: show only variables at the current scope level
print "--- Filtered DUMP (current scope) ---"
dump(0, mode="vars,level="+str(tcb(13)))
