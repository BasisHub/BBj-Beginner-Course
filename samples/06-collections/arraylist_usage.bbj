rem /**
rem  * arraylist_usage.bbj - java.util.ArrayList creation and iteration
rem  *
rem  * Demonstrates creating an ArrayList, adding items,
rem  * and iterating with a for loop.
rem  *
rem  * Expected output:
rem  *   first
rem  *   second
rem  *   third
rem  */

use java.util.ArrayList

list! = new ArrayList()
list!.add("first")
list!.add("second")
list!.add("third")

for i = 0 to list!.size() - 1
    print list!.get(i)
next i

release
