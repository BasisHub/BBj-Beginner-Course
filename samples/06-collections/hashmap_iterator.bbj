rem === java.util.HashMap with Iterator ===
rem Demonstrates: Creating a HashMap, populating with put(), iterating with keySet().iterator()
rem Expected output (order may vary):
rem   name = Alice
rem   role = Developer
rem   team = Platform

use java.util.HashMap
use java.util.Iterator

map! = new HashMap()
map!.put("name", "Alice")
map!.put("role", "Developer")
map!.put("team", "Platform")

rem Iterate using keySet().iterator()
iter! = map!.keySet().iterator()
while iter!.hasNext()
    key! = iter!.next()
    print key!, " = ", map!.get(key!)
wend

release
