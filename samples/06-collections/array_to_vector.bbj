rem === DIM Array to BBjVector Conversion ===
rem Demonstrates: Populating a DIM array, converting to BBjVector with VECTOR() (BBj 16.0+)
rem Expected output:
rem   Vector size: 3
rem   Alice
rem   Bob
rem   Charlie

rem DIM array (fixed size, typed)
dim names$[2]
names$[0] = "Alice"
names$[1] = "Bob"
names$[2] = "Charlie"

rem Convert to BBjVector (BBj 16.0+)
vect! = vector(names$[])
print "Vector size: ", vect!.size()

for i = 0 to vect!.size() - 1
    print vect!.getItem(i)
next i

release
