rem === THROW from a Class Method ===
rem Demonstrates: Raising custom errors with THROW inside a class; propagation to SETERR handler
rem Expected output: Validation error # 256 : Input cannot be empty

class public Validator
    method public void validate(BBjString input$)
        if len(input$) = 0 then
            throw "Input cannot be empty", 256
        fi
        if len(input$) > 100 then
            throw "Input too long (max 100 characters)", 257
        fi
    methodend
classend

seterr handler
declare Validator v!
v! = new Validator()
v!.validate("")
release

handler:
    print "Validation error #", err, ": ", errmes(-1)
    release
