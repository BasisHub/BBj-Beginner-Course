rem === Handling Java Exceptions in BBj ===
rem Demonstrates: Java exceptions trapped as BBj error 252; ERR= to catch, getLastJavaException() to inspect
rem Expected output: Error: 252  -  Java exception

use java.util.HashMap

map! = new HashMap()
x$ = map!.get("missing_key", err=oops)
print "Got value: ", x$
release

oops:
    print "Error: ", err, " - ", errmes(-1)
    release
